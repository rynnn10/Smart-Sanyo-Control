# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# CLASP_DEPLOYMENT_ID: Deployment ID dari Google Apps Script Web App.
# Copy dari Apps Script Editor → Deploy → Manage deployments → ambil ID.
# Atau lihat URL Web App: .../macros/s/<INI>/exec
# Digunakan oleh npm run gas:deploy & gas:watch-deploy untuk redeploy ke deployment yg sama.
# File .env isinya gitignored - jangan commit ke repo!
CLASP_DEPLOYMENT_ID=

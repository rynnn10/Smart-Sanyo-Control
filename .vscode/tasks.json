{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🚀 Build & Install ke HP (Auto-Scan)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\run.ps1"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "📱 Build & Install ke HP (Manual IP)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "& { $ip = Read-Host 'Masukkan IP HP (contoh: 192.168.1.7:5555)'; & \"${workspaceFolder}\\run.ps1\" -DeviceId $ip }"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "⚙️ Gradle Build Only (no install)",
            "type": "shell",
            "command": "${workspaceFolder}\\gradlew.bat",
            "args": [
                ":app:assembleDebug",
                "--no-daemon"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            },
            "problemMatcher": [
                "$gradle"
            ]
        }
    ]
}